{
  "harness-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/bin/harness hook posttooluse",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "harness-gates": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/bin/harness hook pretooluse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/bin/harness hook agy-preinvocation",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/bin/harness hook agy-stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
