{
  "harness-format": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/format-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "harness-gates": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/bin/resume-context.sh --agy",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/bin/trail-check.sh --agy",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
